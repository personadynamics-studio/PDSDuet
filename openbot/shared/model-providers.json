{
  "_readme": "Provider facts and model defaults for the TypeScript LangGraph endpoint and the ChatGPT subscription bridge. BOT_PROVIDER and BOT_MODEL override defaults where that runtime supports them. Credentials stay in the environment. Provider IDs are declared in shared/model-providers.ts.",
  "providers": {
    "openai": {
      "label": "OpenAI",
      "key_variable": "OPENAI_API_KEY",
      "base_url_variable": "OPENAI_BASE_URL",
      "default_model": "gpt-5.5"
    },
    "anthropic": {
      "label": "Anthropic",
      "key_variable": "ANTHROPIC_API_KEY",
      "base_url_variable": "ANTHROPIC_BASE_URL",
      "default_model": "claude-sonnet-4-5"
    },
    "google": {
      "label": "Google",
      "key_variable": "GOOGLE_API_KEY",
      "base_url_variable": "GOOGLE_GENERATIVE_AI_BASE_URL",
      "default_model": "gemini-2.5-flash"
    }
  },
  "bots": {
    "agent-langgraph": { "provider": "openai", "model": "gpt-5.5" },
    "agent-langgraph-agui": { "provider": "openai", "model": "gpt-4o-mini" }
  }
}
